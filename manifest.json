{
  "manifest_version": 3,
  "name": "MoneyNex",
  "description": "A Hacash and Bitcoin wallet with an open SDK",
  "version": "0.4.1",
  "minimum_chrome_version": "114",
  "author": "Mr. H",
  "homepage_url": "https://github.com/hacashcom/MoneyNex",
  "icons": {
    "16": "image/icos/logo-16.png",
    "32": "image/icos/logo-32.png",
    "64": "image/icos/logo-64.png",
    "128": "image/icos/logo-128.png"
  },
  "permissions": [
    "storage",
    "clipboardWrite",
    "sidePanel",
    "notifications"
  ],
  "host_permissions": [
    "https://hacash.org/*",
    "https://*.hacash.org/*",
    "https://*.hacash.com/*",
    "https://wallet.hacash.com/*"
  ],
  "background": {
    "service_worker": "background/background.js"
  },
  "action": {
    "default_icon": {
      "16": "image/icos/logo-16.png",
      "32": "image/icos/logo-32.png",
      "64": "image/icos/logo-64.png",
      "128": "image/icos/logo-128.png"
    },
    "default_popup": "popup/moneynex.html",
    "default_title": "MoneyNex"
  },
  "side_panel": {
    "default_path": "popup/moneynex.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+M",
        "windows": "Alt+Shift+M",
        "mac": "Alt+Shift+M",
        "chromeos": "Alt+Shift+M",
        "linux": "Alt+Shift+M"
      }
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://*.google.com/*"
      ],
      "js": [
        "content/content.min.js"
      ],
      "css": [
        "content/content.min.css"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "exclude_matches": [
        "*://*.google.com/*"
      ],
      "resources": [
        "content/hacash_api.min.js",
        "image/icos/128.png"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}